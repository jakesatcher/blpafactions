# Postgres connection string used by Prisma
DATABASE_URL="postgresql://ods_dev:ods_dev_pw@localhost:5432/ods_dev?schema=public"

# HTTP port for the API server
PORT=3000

# --- LeagueApps Private API (verified against real docs) ---
# Used by POST /sync/leagueapps/members (src/services/memberImport.ts,
# src/services/leagueappsPrivateApi.ts). Base URL and site ID come from
# https://leagueapps.notion.site/LeagueApps-API-Documentation's server
# table — production is https://public.leagueapps.io; dev1/sandbox use
# different hosts, see README.
LEAGUEAPPS_API_BASE="https://public.leagueapps.io"
LEAGUEAPPS_SITE_ID=""

# The Private API Key (aka "client ID" / "service account") generated at
# Admin Dashboard > Connect > API Settings. Authenticates via a signed
# JWT assertion, not a static bearer token — see src/services/leagueappsAuth.ts.
LEAGUEAPPS_CLIENT_ID=""

# PEM-encoded RSA private key from that same Private API Key's downloaded
# .p12 file, converted with:
#   openssl pkcs12 -nodes -legacy -in <client-id>.p12 -out <client-id>.pem
# Paste the full PEM (including the BEGIN/END lines) as this value — on
# Heroku: heroku config:set LEAGUEAPPS_PRIVATE_KEY="$(cat <client-id>.pem)"
LEAGUEAPPS_PRIVATE_KEY=""

# OAuth2 token endpoint for the JWT-bearer exchange. Same value across
# LeagueApps environments per the docs; override only if that changes.
LEAGUEAPPS_AUTH_URL="https://auth.leagueapps.io/v2/auth/token"

# --- LeagueApps registrations/webhook (UNVERIFIED — see README) ---
# These predate the Private API docs above and were never confirmed
# against a real LeagueApps spec. Kept as-is (POST /sync/leagueapps/events/:id,
# POST /webhooks/leagueapps) but not recommended until checked against docs.
LEAGUEAPPS_API_KEY=""
LEAGUEAPPS_WEBHOOK_SECRET=""

# Shared secret required (as an x-admin-token header) to create/modify
# players and events, or view a player's email. The GUI at "/" prompts
# for this and stores it in the browser's localStorage. Optional in local
# dev (unset = no auth check); REQUIRED before deploying — the app
# refuses to boot on Heroku or Railway (detected via DYNO /
# RAILWAY_ENVIRONMENT_ID) without it.
ADMIN_TOKEN=""
